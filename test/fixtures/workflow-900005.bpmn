    "documentTemplates": [
        {
            "id": 900005001,
            "name": "Text and numbers",
            "jsonSchema": {
                "title": "Text and numbers",
                "type": "object",
                "pdfRequired": false,
                "signRequired": false,
                "forceRedirect": true,
                "calcTriggers": [],
                "finalScreen": {
                    "title": "() => `<p>👍 Thank you, the application has been sent!</p>`",
                    "subtitle": "  "
                },
                "properties": {
                    "textNumbers": {
                        "type": "object",
                        "description": "Text and numbers",
                        "properties": {
                            "textValue": {
                                "type": "string",
                                "description": "Text value",
                                "checkRequired": "() => true",
                                "minLength": 3,
                                "maxLength": 50
                            },
                            "numberValue": {
                                "type": "number",
                                "description": "Number value",
                                "checkRequired": "() => true",
                                "toFixed": 2,
                                "minimum": 1,
                                "maximum": 1000
                            },
                            "integerValue": {
                                "type": "integer",
                                "description": "Integer value",
                                "checkRequired": "() => true",
                                "minimum": 1,
                                "maximum": 100
                            },
                            "phone": {
                                "type": "string",
                                "control": "phone",
                                "description": "Phone number",
                                "defaultCountry": "ua",
                                "onlyCountries": [
                                    "ua"
                                ],
                                "checkRequired": "() => true",
                                "checkValid": [
                                    {
                                        "isValid": "(value) => !value || value.length === 12",
                                        "errorText": "Phone must have 12 digits"
                                    }
                                ]
                            },
                            "amount": {
                                "type": "number",
                                "control": "currency.input",
                                "description": "Amount",
                                "currencySymbol": "UAH",
                                "checkRequired": "() => true",
                                "minimum": 0.01,
                                "maximum": 1000000
                            },
                            "agree": {
                                "type": "boolean",
                                "control": "toggle",
                                "description": "Agree",
                                "offText": "No",
                                "onText": "Yes",
                                "defaultValue": false
                            }
                        }
                    }
                }
            },
            "jsonSchemaRaw": "{\n  \"title\": \"Text and numbers\",\n  \"type\": \"object\",\n  \"pdfRequired\": false,\n  \"signRequired\": false,\n  \"forceRedirect\": true,\n  \"calcTriggers\": [],\n  \"finalScreen\": {\n    \"title\": \"() => `<p>👍 Thank you, the application has been sent!</p>`\",\n    \"subtitle\": \"  \"\n  },\n  \"properties\": {\n    \"textNumbers\": {\n      \"type\": \"object\",\n      \"description\": \"Text and numbers\",\n      \"properties\": {\n        \"textValue\": {\n          \"type\": \"string\",\n          \"description\": \"Text value\",\n          \"checkRequired\": \"() => true\",\n          \"minLength\": 3,\n          \"maxLength\": 50\n        },\n        \"numberValue\": {\n          \"type\": \"number\",\n          \"description\": \"Number value\",\n          \"checkRequired\": \"() => true\",\n          \"toFixed\": 2,\n          \"minimum\": 1,\n          \"maximum\": 1000\n        },\n        \"integerValue\": {\n          \"type\": \"integer\",\n          \"description\": \"Integer value\",\n          \"checkRequired\": \"() => true\",\n          \"minimum\": 1,\n          \"maximum\": 100\n        },\n        \"phone\": {\n          \"type\": \"string\",\n          \"control\": \"phone\",\n          \"description\": \"Phone number\",\n          \"defaultCountry\": \"ua\",\n          \"onlyCountries\": [\n            \"ua\"\n          ],\n          \"checkRequired\": \"() => true\",\n          \"checkValid\": [\n            {\n              \"isValid\": \"(value) => !value || value.length === 12\",\n              \"errorText\": \"Phone must have 12 digits\"\n            }\n          ]\n        },\n        \"amount\": {\n          \"type\": \"number\",\n          \"control\": \"currency.input\",\n          \"description\": \"Amount\",\n          \"currencySymbol\": \"UAH\",\n          \"checkRequired\": \"() => true\",\n          \"minimum\": 0.01,\n          \"maximum\": 1000000\n        },\n        \"agree\": {\n  