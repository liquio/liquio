  "documentTemplates": [
    {
      "id": 900002001,
      "name": "1.1 - source + checkStepHidden",
      "jsonSchema": {
        "title": "Назва послуги",
        "type": "object",
        "signRequired": false,
        "pdfRequired": false,
        "diiaSign": false,
        "isP7sSign": false,
        "forceRedirect": false,
        "calcTriggers": [
          {
            "source": "stringInfo.radio",
            "target": "stringInfo.result",
            "calculate": "(value, step, documentData, parent) => step?.radio;",
            "readOnly": true,
            "validate": true
          },
          {
            "source": "stringSha256Info.radio",
            "target": "stringSha256Info.result",
            "useSha256": true,
            "calculate": "(value, step, documentData, parent) => step?.radio;",
            "validate": true
          },
          {
            "source": "allStarsInfo.radio",
            "target": "allStarsInfo.resultNumber",
            "calculate": "(value, step, documentData, parent) => Number(step?.radio?.replace(/\\D/g, ''));",
            "validate": true
          },
          {
            "source": "allStarsInfo.radio",
            "target": "allStarsInfo.resultBoolean",
            "calculate": "(value, step, documentData, parent) => Boolean(step?.radio);",
            "validate": true
          },
          {
            "source": "allStarsInfo.radio",
            "target": "allStarsInfo.resultObject",
            "calculate": "(value, step, documentData, parent) => ({stringOne: step?.radio + '(1)',stringTwo: step?.radio + '(2)'});",
            "validate": true
          },
          {
            "source": "allStarsInfo.radio",
            "target": "allStarsInfo.resultArrayOfStrings",
            "calculate": "(value, step, documentData, parent) => [step?.radio + '(1)', step?.radio + '(2)'];",
            "validate": true
          },
          {
            "source": "allStarsInfo.radio",
            "target": "allStarsInfo.resultArrayOfObjects",
            "calculate": "(value, step, documentData, parent) => [{stringOne: step?.radio + '(об\\'єкт 1 елемент 1)',stringTwo: step?.radio + '(об\\'єкт 1 елемент 2)'}, {stringOne: step?.radio + '(об\\'єкт 2 елемент 1)',stringTwo: step?.radio + '(об\\'єкт 2 елемент 2)'}];",
            "validate": true
          },
          {
            "source": "stepHiddenInfo.radio",
            "target": "stepHiddenInfo.result",
            "calculate": "(value, step, documentData, parent) => step?.radio;",
            "validate": true
          },
          {
            "source": "hiddenFieldInfo.radio",
            "target": "hiddenFieldInfo.result",
            "calculate": "(value, step, documentData, parent) => step?.radio;",
            "validate": true
          },
          {
            "step": "hiddenFieldInfo",
            "target": "indexInfo.resultArray",
            "calculate": "(value, step, documentData, parent) => [{fullName: 'Тестовий Василь Петрович'}, {fullName: 'Тестовий Петро Васильович'}];",
            "validate": false
          },
          {
            "source": "indexInfo.resultArray.${index}.date",
            "target": "indexInfo.resultArray.${index}.result",
            "calculate": "(value, step, documentData, parent) => value ? `${value} р.н.` : undefined;",
            "validate": true
          }
        ],
        "properties": {
          "calculated": {
            "type": "object",
            "description": "Розрахункові дані",
            "checkStepHidden": "() => true",
            "properties": {}
          },
          "stringInfo": {
            "description": "source string",
            "type": "object",
            "properties": {
              "radio": {
                "type": "string",
                "control": "radio.group",
                "checkRequired": "() => true",
                "description": "Натисність на радіокнопку",
                "readOnly": true,
                "items": [
                  {
                    "id": "Радіокнопка 1",
                    "title": "Радіокнопка 1"
                  },
                  {
                    "id": "Радіокнопка 2",
                    "title": "Радіокнопка 2"
                  }
                ]
              },
              "result": {
                "type": "string",
                "checkRequired": "() => true",
                "checkHidden": "() => false",
                "isDisabled": true,
                "description": "Результат тригеру"
              }
            }
          },
          "stringSha256Info": {
            "description": "useSha256",
            "type": "object",
            "properties": {
              "radio": {
                "type": "string",
                "control": "radio.group",
                "checkRequired": "() => true",
                "description": "Натисність на радіокнопку",
                "items": [
                  {
                    "id": "Радіокнопка 1",
                    "title": "Радіокнопка 1"
                  },
                  {
                    "id": "Радіокнопка 2",
                    "title": "Радіокнопка 2"
                  }
                ]
              },
              "result": {
                "type": "string",
                "checkRequired": "() => true",
                "checkHidden": "() => false",
                "isDisabled": true,
                "description": "Результат тригеру з використанням хешування sha256"
              }
            }
          },
          "allStarsInfo": {
            "description": "Крок, на якому розруховуються різні типи даних",
            "type": "object",
            "properties": {
              "radio": {
                "type": "string",
                "control": "radio.group",
                "checkRequired": "() => true",
                "description": "Натисність на радіокнопку",
                "items": [
                  {
                    "id": "Радіокнопка 1",
                    "title": "Радіокнопка 1"
                  },
                  {
                    "id": "Радіокнопка 2",
                    "title": "Радіокнопка 2"
                  }
                ]
              },
              "resultNumber": {
                "type": "number",
                "description": "Поле number",
                "checkRequired": "() => true",
                "isDisabled": true
              },
              "resultBoolean": {
                "description": "Поле boolean",
                "type": "boolean",
                "control": "toggle",
                "offText": "Ще не тригернулись",
                "onText": "Тригер пройшов успішно",
                "defaultValue": false,
                "checkRequired": "() => true",
                "isDisabled": true
              },
              "resultObject": {
                "type": "object",
                "description": "Поле Object",
                "checkRequired": "() => true",
                "outlined": false,
                "control": "form.group",
                "properties": {
                  "stringOne": {
                    "type": "string",
                    "description": "Результат розрахунку в об'єкті",
                    "checkRequired": "() => true",
                    "isDisabled": true
                  },
                  "stringTwo": {
                    "type": "string",
                    "description": "Результат розрахунку в об'єкті",
                    "checkRequired": "() => true",
                    "isDisabled": true
                  }
                }
              },
              "resultArrayOfStrings": {
                "type": "array",
                "description": "Масив рядків",
                "allowAdd": "() => true",
                "allowDelete": "() => true",
                "checkRequired": "() => true",
                "isDisabled": true,
                "items": {
                  "type": "string",
                  "description": "Результат розрахунку рядка в масиві рядків",
                  "checkRequired": "() => true",
                  "isDisabled": true
                }
              },
              "resultArrayOfObjects": {
                "type": "array",
                "description": "Масив об'єктів",
                "allowAdd": "() => true",
                "allowDelete": "() => true",
                "checkRequired": "() => true",
                "isDisabled": true,
                "items": {
                  "type": "object",
                  "description": "Object",
                  "checkRequired": "() => true",
                  "outlined": false,
                  "control": "form.group",
                  "properties": {
                    "stringOne": {
                      "type": "string",
                      "description": "Результат розрахунку в об'єкті",
                      "checkRequired": "() => true",
                      "isDisabled": true
                    },
                    "stringTwo": {
                      "type": "string",
                      "description": "Результат розрахунку в об'єкті",
                      "checkRequired": "() => true",
                      "isDisabled": true
                    }
                  }
                }
              }
            }
          },
          "stepHiddenInfo": {
            "description": "Тригер всередені checkStepHidden",
            "checkStepHidden": "() => true",
            "type": "object",
            "properties": {
              "radio": {
                "type": "string",
                "control": "radio.group",
                "checkRequired": "() => false",
                "description": "Натисність на радіокнопку",
                "items": [
                  {
                    "id": "Радіокнопка 1",
                    "title": "Радіокнопка 1"
                  },
                  {
                    "id": "Радіокнопка 2",
                    "title": "Радіокнопка 2"
                  }
                ]
              },
              "result": {
                "type": "string",
                "checkRequired": "() => false",
                "checkHidden": "() => false",
                "isDisabled": true,
                "description": "Результат тригеру"
              }
            }
          },
          "hiddenFieldInfo": {
            "description": "Приховане поле, на якому є тригер",
            "type": "object",
            "properties": {
              "radio": {
                "type": "string",
                "control": "radio.group",
                "checkRequired": "() => false",
                "checkHidden": "() => true",
                "description": "Натисність на радіокнопку",
                "items": [
                  {
                    "id": "Радіокнопка 1",
                    "title": "Радіокнопка 1"
                  },
                  {
                    "id": "Радіокнопка 2",
                    "title": "Радіокнопка 2"
                  }
                ]
              },
              "result": {
                "type": "string",
                "checkRequired": "() => false",
                "checkHidden": "() => false",
                "isDisabled": true,
                "description": "Результат тригеру"
              }
            }
          },
          "indexInfo": {
            "description": "Індекси в таргеті та сорсі",
            "type": "object",
            "properties": {
              "resultArray": {
                "type": "array",
                "description": "Масив об'єктів",
                "checkRequired": "() => true",
                "allowDelete": "() => false",
                "allowAdd": "(value) => !value?.length > 0",
                "isDisabled": false,
                "items": {
                  "type": "object",
                  "description": "Object",
                  "checkRequired": "() => true",
                  "properties": {
                    "fullName": {
                      "type": "string",
                      "description": "Повне ім'я",
                      "checkRequired": "() => true",
                      "isDisabled": true
                    },
                    "date": {
                      "type": "string",
                      "control": "date",
                      "checkRequired": "() => true",
                      "minDate": "(value, step, documentData) => moment('01.01.1900', 'DD.MM.YYYY');",
                      "maxDate": "(value, step, documentData) => moment();",
                      "description": "Вкажіть дату народження"
                    },
                    "result": {
                      "type": "string",
                      "checkRequired": "() => true",
                      "checkHidden": "() => false",
                      "isDisabled": true,
                      "description": "Результат тригеру",
                      "readOnly": true
                    }
                  }
                }
              }
            }
          }
        }
      },
      "jsonSchemaRaw": "{\n    \"title\": \"Назва послуги\",\n    \"type\": \"object\",\n    \"signRequired\": false,\n    \"pdfRequired\": false,\n    \"diiaSign\": false,\n    \"isP7sSign\": false,\n    \"forceRedirect\": false,\n    \"calcTriggers\": [\n        {\n            \"source\": \"stringInfo.radio\",\n            \"target\": \"stringInfo.result\",\n            \"calculate\": \"(value, step, documentData, parent) => step?.radio;\",\n            \"readOnly\": true,\n            \"validate\": true\n        },\n        {\n            \"source\": \"stringSha256Info.radio\",\n            \"target\": \"stringSha256Info.result\",\n            \"useSha256\": true,\n            \"calculate\": \"(value, step, documentData, parent) => step?.radio;\",\n            \"validate\": true\n        },\n        {\n            \"source\": \"allStarsInfo.radio\",\n            \"target\": \"allStarsInfo.resultNumber\",\n            \"calculate\": \"(value, step, documentData, parent) => Number(step?.radio?.replace(/\\\\D/g, ''));\",\n            \"validate\": true\n        },\n        {\n            \"source\": \"allStarsInfo.radio\",\n            \"target\": \"allStarsInfo.resultBoolean\",\n            \"calculate\": \"(value, step, documentData, parent) => Boolean(step?.radio);\",\n            \"validate\": true\n        },\n        {\n            \"source\": \"allStarsInfo.radio\",\n            \"target\": \"allStarsInfo.resultObject\",\n            \"calculate\": \"(value, step, documentData, parent) => ({stringOne: step?.radio + '(1)',stringTwo: step?.radio + '(2)'});\",\n            \"validate\": true\n        },\n        {\n            \"source\": \"allStarsInfo.radio\",\n            \"target\": \"allStarsInfo.resultArrayOfStrings\",\n            \"calculate\": \"(value, step, documentData, parent) => [step?.radio + '(1)', step?.radio + '(2)'];\",\n            \"validate\": true\n        },\n        {\n            \"source\": \"allStarsInfo.radio\",\n            \"target\": \"allStarsInfo.resultArrayOfObjects\",\n            \"calculate\": \"(value, step, documentData, parent) => [{stringOne: step?.radio + '(об\\\\'єкт 1 елемент 1)',stringTwo: step?.radio + '(об\\\\'єкт 1 елемент 2)'}, {stringOne: step?.radio + '(об\\\\'єкт 2 елемент 1)',stringTwo: step?.radio + '(об\\\\'єкт 2 елемент 2)'}];\",\n            \"validate\": true\n        },\n        {\n            \"source\": \"stepHiddenInfo.radio\",\n            \"target\": \"stepHiddenInfo.result\",\n            \"calculate\": \"(value, step, documentData, parent) => step?.radio;\",\n            \"validate\": true\n        },\n        {\n            \"source\": \"hiddenFieldInfo.radio\",\n            \"target\": \"hiddenFieldInfo.result\",\n            \"calculate\": \"(value, step, documentData, parent) => step?.radio;\",\n            \"validate\": true\n        },\n        {\n            \"step\": \"hiddenFieldInfo\",\n            \"target\": \"indexInfo.resultArray\",\n            \"calculate\": \"(value, step, documentData, parent) => [{fullName: 'Тестовий Василь Петрович'}, {fullName: 'Тестовий Петро Васильович'}];\",\n            \"validate\": false\n        },\n        {\n            \"source\": \"indexInfo.resultArray.${index}.date\",\n            \"target\": \"indexInfo.resultArray.${index}.result\",\n            \"calculate\": \"(value, step, documentData, parent) => value ? `${value} р.н.` : undefined;\",\n            \"validate\": true\n        }\n    ],\n    \"properties\": {\n        \"calculated\": {\n            \"type\": \"object\",\n            \"description\": \"Розрахункові дані\",\n            \"checkStepHidden\": \"() => true\",\n            \"properties\": {}\n        },\n        \"stringInfo\": {\n            \"description\": \"source string\",\n            \"type\": \"object\",\n            \"properties\": {\n                \"radio\": {\n                    \"type\": \"string\",\n                    \"control\": \"radio.group\",\n                    \"checkRequired\": \"() => true\",\n                    \"description\": \"Натисність на радіокнопку\",\n                    \"readOnly\": true,\n                    \"items\": [\n                        {\n                            \"id\": \"Радіокнопка 1\",\n                            \"title\": \"Радіокнопка 1\"\n                        },\n                        {\n                            \"id\": \"Радіокнопка 2\",\n                            \"title\": \"Радіокнопка 2\"\n                        }\n                    ]\n                },\n                \"result\": {\n                    \"type\": \"string\",\n                    \"checkRequired\": \"() => true\",\n                    \"checkHidden\": \"() => false\",\n                    \"isDisabled\": true,\n                    \"description\": \"Результат тригеру\"\n                }\n            }\n        },\n        \"stringSha256Info\": {\n            \"description\": \"useSha256\",\n            \"type\": \"object\",\n            \"properties\": {\n                \"radio\": {\n                    \"type\": \"string\",\n                    \"control\": \"radio.group\",\n                    \"checkRequired\": \"() => true\",\n                    \"description\": \"Натисність на радіокнопку\",\n                    \"items\": [\n                        {\n                            \"id\": \"Радіокнопка 1\",\n                            \"title\": \"Радіокнопка 1\"\n                        },\n                        {\n                            \"id\": \"Радіокнопка 2\",\n                            \"title\": \"Радіокнопка 2\"\n                        }\n                    ]\n                },\n                \"result\": {\n                    \"type\": \"string\",\n                    \"checkRequired\": \"() => true\",\n                    \"checkHidden\": \"() => false\",\n                    \"isDisabled\": true,\n                    \"description\": \"Результат тригеру з використанням хешування sha256\"\n                }\n            }\n        },\n        \"allStarsInfo\": {\n            \"description\": \"Крок, на якому розруховуються різні типи даних\",\n            \"type\": \"object\",\n            \"properties\": {\n                \"radio\": {\n                    \"type\": \"string\",\n                    \"control\": \"radio.group\",\n                    \"checkRequired\": \"() => true\",\n                    \"description\": \"Натисність на радіокнопку\",\n                    \"items\": [\n                        {\n                            \"id\": \"Радіокнопка 1\",\n                            \"title\": \"Радіокнопка 1\"\n                        },\n                        {\n                            \"id\": \"Радіокнопка 2\",\n                            \"title\": \"Радіокнопка 2\"\n                        }\n                    ]\n                },\n                \"resultNumber\": {\n                    \"type\": \"number\",\n                    \"description\": \"Поле number\",\n                    \"checkRequired\": \"() => true\",\n                    \"isDisabled\": true\n                },\n                \"resultBoolean\": {\n                    \"description\": \"Поле boolean\",\n                    \"type\": \"boolean\",\n                    \"control\": \"toggle\",\n                    \"offText\": \"Ще не тригернулись\",\n                    \"onText\": \"Тригер пройшов успішно\",\n                    \"defaultValue\": false,\n                    \"checkRequired\": \"() => true\",\n                    \"isDisabled\": true\n                },\n                \"resultObject\": {\n                    \"type\": \"object\",\n                    \"description\": \"Поле Object\",\n                    \"checkRequired\": \"() => true\",\n                    \"outlined\": false,\n                    \"control\": \"form.group\",\n                    \"properties\": {\n                        \"stringOne\": {\n              