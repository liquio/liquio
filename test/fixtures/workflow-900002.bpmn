      "jsonSchemaRaw": "{\n    \"title\": \"Назва послуги\",\n    \"type\": \"object\",\n    \"signRequired\": false,\n    \"pdfRequired\": false,\n    \"diiaSign\": false,\n    \"isP7sSign\": false,\n    \"forceRedirect\": false,\n    \"stepOrders\": \"() => ['stringInfo', 'stringSha256Info', 'allStarsInfo', 'hiddenFieldInfo', 'indexInfo'];\",\n    \"calcTriggers\": [\n        {\n            \"source\": \"stringInfo.radio\",\n            \"target\": \"stringInfo.result\",\n            \"calculate\": \"(value, step, documentData, parent) => step?.radio;\",\n            \"validate\": true\n        },\n        {\n            \"source\": \"stringSha256Info.radio\",\n            \"target\": \"stringSha256Info.result\",\n            \"useSha256\": true,\n            \"calculate\": \"(value, step, documentData, parent) => step?.radio;\",\n            \"validate\": true\n        },\n        {\n            \"source\": \"allStarsInfo.radio\",\n            \"target\": \"allStarsInfo.resultNumber\",\n            \"calculate\": \"(value, step, documentData, parent) => Number(step?.radio?.replace(/\\\\D/g, ''));\",\n            \"validate\": true\n        },\n        {\n            \"source\": \"allStarsInfo.radio\",\n            \"target\": \"allStarsInfo.resultBoolean\",\n            \"calculate\": \"(value, step, documentData, parent) => Boolean(step?.radio);\",\n            \"validate\": true\n        },\n        {\n            \"source\": \"allStarsInfo.radio\",\n            \"target\": \"allStarsInfo.resultObject\",\n            \"calculate\": \"(value, step, documentData, parent) => ({stringOne: step?.radio + '(1)',stringTwo: step?.radio + '(2)'});\",\n            \"validate\": true\n        },\n        {\n            \"source\": \"allStarsInfo.radio\",\n            \"target\": \"allStarsInfo.resultArrayOfStrings\",\n            \"calculate\": \"(value, step, documentData, parent) => [step?.radio + '(1)', step?.radio + '(2)'];\",\n            \"validate\": true\n        },\n        {\n            \"source\": \"allStarsInfo.radio\",\n            \"target\": \"allStarsInfo.resultArrayOfObjects\",\n            \"calculate\": \"(value, step, documentData, parent) => [{stringOne: step?.radio + '(об\\\\'єкт 1 елемент 1)',stringTwo: step?.radio + '(об\\\\'єкт 1 елемент 2)'}, {stringOne: step?.radio + '(об\\\\'єкт 2 елемент 1)',stringTwo: step?.radio + '(об\\\\'єкт 2 елемент 2)'}];\",\n            \"validate\": true\n        },\n        {\n            \"source\": \"stepHiddenInfo.radio\",\n            \"target\": \"stepHiddenInfo.result\",\n            \"calculate\": \"(value, step, documentData, parent) => step?.radio;\",\n            \"validate\": true\n        },\n        {\n            \"source\": \"hiddenFieldInfo.radio\",\n            \"target\": \"hiddenFieldInfo.result\",\n            \"calculate\": \"(value, step, documentData, parent) => step?.radio;\",\n            \"validate\": true\n        },\n        {\n            \"step\": \"hiddenFieldInfo\",\n            \"target\": \"indexInfo.resultArray\",\n            \"calculate\": \"(value, step, documentData, parent) => [{fullName: 'Тестовий Василь Петрович'}, {fullName: 'Тестовий Петро Васильович'}];\"\n        },\n        {\n            \"source\": \"indexInfo.resultArray.${index}.date\",\n            \"target\": \"indexInfo.resultArray.${index}.result\",\n            \"calculate\": \"(value, step, documentData, parent) => value ? `${value} р.н.` : undefined;\",\n            \"validate\": true\n        }\n    ],\n    \"properties\": {\n        \"calculated\": {\n            \"type\": \"object\",\n            \"description\": \"Розрахункові дані\",\n            \"properties\": {}\n        },\n        \"stringInfo\": {\n            \"description\": \"source string\",\n            \"type\": \"object\",\n            \"properties\": {\n                \"radio\": {\n                    \"type\": \"string\",\n                    \"control\": \"radio.group\",\n                    \"checkRequired\": \"() => true\",\n                    \"description\": \"Натисність на радіокнопку\",\n                    \"items\": [\n                        {\n                            \"id\": \"Радіокнопка 1\",\n                            \"title\": \"Радіокнопка 1\"\n                        },\n                        {\n                            \"id\": \"Радіокнопка 2\",\n                            \"title\": \"Радіокнопка 2\"\n                        }\n                    ]\n                },\n                \"result\": {\n                    \"type\": \"string\",\n                    \"checkRequired\": \"() => true\",\n                    \"checkHidden\": \"() => false\",\n                    \"isDisabled\": true,\n                    \"description\": \"Результат тригеру\"\n                }\n            }\n        },\n        \"stringSha256Info\": {\n            \"description\": \"useSha256\",\n            \"type\": \"object\",\n            \"properties\": {\n                \"radio\": {\n                    \"type\": \"string\",\n                    \"control\": \"radio.group\",\n                    \"checkRequired\": \"() => true\",\n                    \"description\": \"Натисність на радіокнопку\",\n                    \"items\": [\n                        {\n                            \"id\": \"Радіокнопка 1\",\n                            \"title\": \"Радіокнопка 1\"\n                        },\n                        {\n                            \"id\": \"Радіокнопка 2\",\n                            \"title\": \"Радіокнопка 2\"\n                        }\n                    ]\n                },\n                \"result\": {\n                    \"type\": \"string\",\n                    \"checkRequired\": \"() => true\",\n                    \"checkHidden\": \"() => false\",\n                    \"isDisabled\": true,\n                    \"description\": \"Результат тригеру з використанням хешування sha256\"\n                }\n            }\n        },\n        \"allStarsInfo\": {\n            \"description\": \"Крок, на якому розруховуються різні типи даних\",\n            \"type\": \"object\",\n            \"properties\": {\n                \"radio\": {\n                    \"type\": \"string\",\n                    \"control\": \"radio.group\",\n                    \"checkRequired\": \"() => true\",\n                    \"description\": \"Натисність на радіокнопку\",\n                    \"items\": [\n                        {\n                            \"id\": \"Радіокнопка 1\",\n                            \"title\": \"Радіокнопка 1\"\n                        },\n                        {\n                            \"id\": \"Радіокнопка 2\",\n                            \"title\": \"Радіокнопка 2\"\n                        }\n                    ]\n                },\n                \"resultNumber\": {\n                    \"type\": \"number\",\n                    \"description\": \"Поле number\",\n                    \"checkRequired\": \"() => true\",\n                    \"isDisabled\": true\n                },\n                \"resultBoolean\": {\n                    \"description\": \"Поле boolean\",\n                    \"type\": \"boolean\",\n                    \"control\": \"toggle\",\n                    \"offText\": \"Ще не тригернулись\",\n                    \"onText\": \"Тригер пройшов успішно\",\n                    \"defaultValue\": false,\n                    \"checkRequired\": \"() => true\",\n                    \"isDisabled\": true\n                },\n                \"resultObject\": {\n                    \"type\": \"object\",\n                    \"description\": \"Поле Object\",\n                    \"checkRequired\": \"() => true\",\n                    \"outlined\": false,\n                    \"control\": \"form.group\",\n                    \"properties\": {\n                        \"stringOne\": {\n                            \"type\": \"string\",\n                            \"description\": \"Результат розрахунку в об'єкті\",\n                            \"checkRequired\": \"() => true\",\n                            \"isDisabled\": true\n                        },\n                        \"stringTwo\": {\n                            \"type\": \"string\",\n                            \"description\": \"Результат розрахунку в об'єкті\",\n                            \"checkRequired\": \"() => true\",\n                            \"isDisabled\": true\n                        }\n                    }\n                },\n                \"resultArrayOfStrings\": {\n                    \"type\": \"array\",\n                    \"description\": \"Масив рядків\",\n                    \"allowAdd\": \"() => true\",\n                    \"allowDelete\": \"() => true\",\n                    \"checkRequired\": \"() => true\",\n                    \"isDisabled\": true,\n                    \"items\": {\n                        \"type\": \"string\",\n                        \"description\": \"Результат розрахунку рядка в масиві рядків\",\n                        \"checkRequired\": \"() => true\",\n                        \"isDisabled\": true\n                    }\n                },\n                \"resultArrayOfObjects\": {\n                    \"type\": \"array\",\n                    \"description\": \"Масив об'єктів\",\n                    \"allowAdd\": \"() => true\",\n                    \"allowDelete\": \"() => true\",\n                    \"checkRequired\": \"() => true\",\n                    \"isDisabled\": true,\n                    \"items\": {\n                        \"type\": \"object\",\n                        \"description\": \"Object\",\n                        \"checkRequired\": \"() => true\",\n                        \"outlined\": false,\n                        \"control\": \"form.group\",\n                        \"properties\": {\n                            \"stringOne\": {\n                                \"type\": \"string\",\n                                \"description\": \"Результат розрахунку в об'єкті\",\n                                \"checkRequired\": \"() => true\",\n                                \"isDisabled\": true\n                            },\n                            \"stringTwo\": {\n                                \"type\": \"string\",\n                                \"description\": \"Результат розрахунку в об'єкті\",\n                                \"checkRequired\": \"() => true\",\n                                \"isDisabled\": true\n                            }\n                        }\n                    }\n                }\n            }\n        },\n        \"stepHiddenInfo\": {\n            \"description\": \"Тригер всередені checkStepHidden\",\n            \"type\": \"object\",\n            \"properties\": {\n                \"radio\": {\n                    \"type\": \"string\",\n                    \"control\": \"radio.group\",\n                    \"checkRequired\": \"() => false\",\n                    \"description\": \"Натисність на радіокнопку\",\n                    \"items\": [\n                        {\n                            \"id\": \"Радіокнопка 1\",\n                            \"title\": \"Радіокнопка 1\"\n                        },\n                        {\n                            \"id\": \"Радіокнопка 2\",\n                            \"title\": \"Радіокнопка 2\"\n                        }\n                    ]\n                },\n                \"result\": {\n                    \"type\": \"string\",\n                    \"checkRequired\": \"() => false\",\n                    \"checkHidden\": \"() => false\",\n                    \"isDisabled\": true,\n                    \"description\": \"Результат тригеру\"\n                }\n            }\n        },\n        \"hiddenFieldInfo\": {\n            \"description\": \"Приховане поле, на якому є тригер\",\n            \"type\": \"object\",\n            \"properties\": {\n                \"radio\": {\n                    \"type\": \"string\",\n                    \"control\": \"radio.group\",\n                    \"checkRequired\": \"() => false\",\n                    \"checkHidden\": \"() => true\",\n                    \"description\": \"Натисність на радіокнопку\",\n                    \"items\": [\n                        {\n                            \"id\": \"Радіокнопка 1\",\n                            \"title\": \"Радіокнопка 1\"\n                        },\n                        {\n                            \"id\": \"Радіокнопка 2\",\n                            \"title\": \"Радіокнопка 2\"\n                        }\n                    ]\n                },\n                \"result\": {\n                    \"type\": \"string\",\n                    \"checkRequired\": \"() => false\",\n                    \"checkHidden\": \"() => false\",\n                    \"isDisabled\": true,\n                    \"description\": \"Результат тригеру\"\n                }\n            }\n        },\n        \"indexInfo\": {\n            \"description\": \"Індекси в таргеті та сорсі\",\n            \"type\": \"object\",\n            \"properties\": {\n                \"resultArray\": {\n                    \"type\": \"array\",\n                    \"description\": \"Масив об'єктів\",\n                    \"checkRequired\": \"() => true\",\n                    \"allowDelete\": \"() => false\",\n                    \"allowAdd\": \"(value) => !value?.length > 0\",\n                    \"isDisabled\": false,\n                    \"items\": {\n                        \"type\": \"object\",\n                        \"description\": \"Object\",\n                        \"checkRequired\": \"() => true\",\n                        \"properties\": {\n                            \"fullName\": {\n                                \"type\": \"string\",\n                                \"description\": \"Повне ім'я\",\n                                \"checkRequired\": \"() => true\",\n                                \"isDisabled\": true\n                            },\n                            \"date\": {\n                                \"type\": \"string\",\n                                \"control\": \"date\",\n                                \"checkRequired\": \"() => true\",\n                                \"minDate\": \"(value, step, documentData) => moment('01.01.1900', 'DD.MM.YYYY');\",\n                                \"maxDate\": \"(value, step, documentData) => moment();\",\n                                \"description\": \"Вкажіть дату народження\"\n                            },\n                            \"result\": {\n                                \"type\": \"string\",\n                                \"checkRequired\": \"() => true\",\n                                \"checkHidden\": \"() => false\",\n                                \"isDisabled\": true,\n                                \"description\": \"Результат тригеру\"\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n}",
      "htmlTemplate": "<pdf-engine>pdf-generator</pdf-engine>\n\n<!DOCTYPE html>\n\n<html lang=\"uk\">\n\n<head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>PDF Title</title>\n    <style>\n        body {\n            font-size: 12px;\n            font-family: Roboto-Regular;\n            margin: 0;\n            padding: 0 20px;\n            line-height: 1;\n            letter-spacing: -0.02em;\n        }\n\n        @font-face {\n            font-family: Roboto-Regular;\n            src: url({{publicUrl}}/fonts/Roboto-Regular.woff);\n        }\n    </style>\n</head>\n\n<body>\n    PDF Template\n</body>\n\n</html>",
      "accessJsonSchema": {
