    "documentTemplates": [
        {
            "id": 900004001,
            "name": "1 - later step appears on Next",
            "jsonSchema": {
                "title": "Наступний крок з'являється",
                "type": "object",
                "signRequired": false,
                "pdfRequired": false,
                "diiaSign": false,
                "isP7sSign": false,
                "forceRedirect": false,
                "calcTriggers": [
                    {
                        "step": "s1",
                        "target": "calculated.showS2",
                        "calculate": "(value, step) => step?.radio === 'Так'"
                    }
                ],
                "properties": {
                    "calculated": {
                        "type": "object",
                        "description": "Розрахункові дані",
                        "checkStepHidden": "() => true",
                        "properties": {
                            "showS2": {
                                "type": "boolean"
                            }
                        }
                    },
                    "s1": {
                        "type": "object",
                        "description": "Крок 1",
                        "properties": {
                            "radio": {
                                "type": "string",
                                "control": "radio.group",
                                "checkRequired": "() => true",
                                "description": "Показати крок 2?",
                                "items": [
                                    {
                                        "id": "Так",
                                        "title": "Так"
                                    },
                                    {
                                        "id": "Ні",
                                        "title": "Ні"
                                    }
                                ]
                            }
                        }
                    },
                    "s2": {
                        "type": "object",
                        "description": "Крок 2",
                        "checkStepHidden": "(documentData) => documentData?.calculated?.showS2 !== true",
                        "properties": {
                            "hint": {
                                "control": "infobox",
                                "text": "Крок 2 показує тригер кроку 1"
                            }
                        }
                    },
                    "s3": {
                        "type": "object",
                        "description": "Крок 3",
                        "properties": {
                            "hint": {
                                "control": "infobox",
                                "text": "Крок 3"
                            }
                        }
                    }
                }
            },
            "jsonSchemaRaw": "{\n    \"title\": \"Наступний крок з'являється\",\n    \"type\": \"object\",\n    \"signRequired\": false,\n    \"pdfRequired\": false,\n    \"diiaSign\": false,\n    \"isP7sSign\": false,\n    \"forceRedirect\": false,\n    \"calcTriggers\": [\n        {\n            \"step\": \"s1\",\n            \"target\": \"calculated.showS2\",\n            \"calculate\": \"(value, step) => step?.radio === 'Так'\"\n        }\n    ],\n    \"properties\": {\n        \"calculated\": {\n            \"type\": \"object\",\n            \"description\": \"Розрахункові дані\",\n            \"checkStepHidden\": \"() => true\",\n            \"properties\": {\n                \"showS2\": {\n                    \"type\": \"boolean\"\n                }\n            }\n        },\n        \"s1\": {\n            \"type\": \"object\",\n            \"description\": \"Крок 1\",\n            \"properties\": {\n                \"radio\": {\n                    \"type\": \"string\",\n                    \"control\": \"radio.group\",\n                    \"checkRequired\": \"() => true\",\n                    \"description\": \"Показати крок 2?\",\n                    \"items\": [\n                        {\n                            \"id\": \"Так\",\n                            \"title\": \"Так\"\n                        },\n                        {\n                            \"id\": \"Ні\",\n                            \"title\": \"Ні\"\n                        }\n                    ]\n                }\n            }\n        },\n        \"s2\": {\n            \"type\": \"object\",\n            \"description\": \"Крок 2\",\n            \"checkStepHidden\": \"(documentData) => documentData?.calculated?.showS2 !== true\",\n            \"properties\": {\n                \"hint\": {\n                    \"control\": \"infobox\",\n                    \"text\": \"Крок 2 показує тригер кроку 1\"\n                }\n            }\n        },\n        \"s3\": {\n            \"type\": \"object\",\n            \"description\": \"Крок 3\",\n            \"properties\": {\n                \"hint\": {\n                    \"control\": \"infobox\",\n                    \"text\": \"Крок 3\"\n                }\n            }\n        }\n    }\n}",
            "htmlTemplate": "<pdf-engine>pdf-generator</pdf-engine>\n\n<!DOCTYPE html>\n\n<html lang=\"uk\">\n\n<head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>PDF Title</title>\n    <style>\n        body {\n            font-size: 12px;\n            font-family: Roboto-Regular;\n            margin: 0;\n            padding: 0 20px;\n            line-height: 1;\n            letter-spacing: -0.02em;\n        }\n\n        @font-face {\n            font-family: Roboto-Regular;\n            src: url({{publicUrl}}/fonts/Roboto-Regular.woff);\n        }\n    </style>\n</head>\n\n<body>\n    PDF Template\n</body>\n\n</html>",
