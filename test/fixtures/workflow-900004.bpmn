            "jsonSchemaRaw": "{\n    \"title\": \"Попередній крок зникає\",\n    \"type\": \"object\",\n    \"signRequired\": false,\n    \"pdfRequired\": false,\n    \"diiaSign\": false,\n    \"isP7sSign\": false,\n    \"forceRedirect\": false,\n    \"calcTriggers\": [\n        {\n            \"step\": \"s2\",\n            \"target\": \"calculated.hideS1\",\n            \"calculate\": \"(value, step) => step?.radio === 'Так'\"\n        }\n    ],\n    \"properties\": {\n        \"calculated\": {\n            \"type\": \"object\",\n            \"description\": \"Розрахункові дані\",\n            \"checkStepHidden\": \"() => true\",\n            \"properties\": {\n                \"hideS1\": {\n                    \"type\": \"boolean\"\n                }\n            }\n        },\n        \"s1\": {\n            \"type\": \"object\",\n            \"description\": \"Крок 1\",\n            \"checkStepHidden\": \"(documentData) => documentData?.calculated?.hideS1 === true\",\n            \"properties\": {\n                \"hint\": {\n                    \"control\": \"infobox\",\n                    \"text\": \"Крок 1 ховає тригер кроку 2\"\n                }\n            }\n        },\n        \"s2\": {\n            \"type\": \"object\",\n            \"description\": \"Крок 2\",\n            \"properties\": {\n                \"radio\": {\n                    \"type\": \"string\",\n                    \"control\": \"radio.group\",\n                    \"checkRequired\": \"() => true\",\n                    \"description\": \"Сховати крок 1?\",\n                    \"items\": [\n                        {\n                            \"id\": \"Так\",\n                            \"title\": \"Так\"\n                        },\n                        {\n                            \"id\": \"Ні\",\n                            \"title\": \"Ні\"\n                        }\n                    ]\n                }\n            }\n        },\n        \"s3\": {\n            \"t