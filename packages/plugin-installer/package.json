{
  "name": "@liquio/plugin-installer",
  "version": "0.1.3",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "description": "Installs Liquio plugin npm packages listed in a component's plugins.json into a shared volume",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "liquio-plugin-installer": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liquio/liquio.git",
    "directory": "packages/plugin-installer"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"const fs=require('fs');const p='dist/cli.js';const c=fs.readFileSync(p,'utf8');if(!c.startsWith('#!/usr/bin/env node')){fs.writeFileSync(p,'#!/usr/bin/env node\\n'+c);}fs.chmodSync(p,0o755);\"",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "jest"
  },
  "dependencies": {
    "@liquio/back-core": "^0.1.0",
    "multiconf": "^4.2.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
