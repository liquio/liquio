{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "src",
    "types": ["vite/client", "vite-plugin-svgr/client"],
    "paths": {
      "actions/*": ["actions/*"],
      "assets/*": ["assets/*"],
      "components/*": ["components/*"],
      "containers/*": ["containers/*"],
      "helpers/*": ["helpers/*"],
      "layouts/*": ["layouts/*"],
      "pages/*": ["pages/*"],
      "reducers/*": ["reducers/*"],
      "routes/*": ["routes/*"],
      "services/*": ["services/*"],
      "store/*": ["store/*"],
      "themes/*": ["themes/*"],
      "variables/*": ["variables/*"],
      "actions": ["actions"],
      "assets": ["assets"],
      "components": ["components"],
      "containers": ["containers"],
      "helpers": ["helpers"],
      "layouts": ["layouts"],
      "pages": ["pages"],
      "reducers": ["reducers"],
      "routes": ["routes"],
      "services": ["services"],
      "store": ["store"],
      "themes": ["themes"],
      "variables": ["variables"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "build"]
}
