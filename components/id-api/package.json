{
  "name": "liquio-id-api",
  "version": "0.1.21",
  "engines": {
    "node": "24"
  },
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "main": "index.js",
  "scripts": {
    "start": "ts-node src/index.ts",
    "start:prod": "node dist/index.js",
    "build": "tsc",
    "lint": "eslint -c eslint.config.js . && npm run test:build",
    "lint:fix": "eslint -c eslint.config.js . --fix",
    "test": "jest src",
    "test:coverage": "jest --coverage src",
    "test:e2e": "jest --coverage --verbose tests",
    "test:build": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "migration-up": "sequelize db:migrate --migrations-path ./migrations --config ./migrations-config.js",
    "migration-create": "sequelize migration:create --config ./migrations-config.js --name ",
    "migration-generate": "sequelize-cli migration:generate --config ./migrations-config.js --name new-migration",
    "migration-down": "sequelize db:migrate:undo:all --config ./migrations-config.js",
    "migration-down-name": "sequelize db:migrate:undo --config ./migrations-config.js --name $name"
  },
  "dependencies": {
    "@liquio/back-core": "^0.2.5",
    "@node-oauth/oauth2-server": "^5.3.0",
    "asn1js": "^3.0.10",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.3.0",
    "compression": "^1.8.2",
    "connect-session-sequelize": "^8.0.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-http-proxy": "^2.1.2",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "ldapts": "^9.2.0",
    "lodash": "^4.18.1",
    "mappr": "^6.1.0",
    "multiconf": "^4.2.2",
    "node-cache": "^5.1.2",
    "node-jose": "^2.2.0",
    "node-rsa": "^2.0.0",
    "node-schedule": "^2.1.1",
    "otpauth": "^9.5.2",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-oauth2": "^1.8.0",
    "passport-strategy": "^1.0.0",
    "pg": "^8.23.1",
    "pkijs": "^3.4.1",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-http-proxy": "^1.6.7",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.4",
    "@types/node-jose": "^1.1.13",
    "@types/node-rsa": "^1.1.4",
    "@types/node-schedule": "^2.1.8",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/passport-oauth2": "^1.8.0",
    "@types/passport-strategy": "^0.2.38",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.2",
    "nock": "^14.0.17",
    "portfinder": "^1.0.38",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    },
    "node-jose": {
      "uuid": "^11.1.1"
    },
    "sequelize": {
      "uuid": "^11.1.1"
    }
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "cpu-features@0.0.10": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true,
    "unrs-resolver@1.12.2": true,
    "@scarf/scarf@1.4.0": true
  }
}
