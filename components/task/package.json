{
  "name": "liquio-task",
  "version": "0.1.20",
  "engines": {
    "node": "24"
  },
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:prod": "node src/index.js",
    "start:ts": "node -r ts-node/register src/index.ts",
    "start:dev": "DISABLE_LOG=true node index.js",
    "build": "tsc",
    "migration-up": "sequelize db:migrate",
    "migration-clear": "sequelize db:migrate:undo:all",
    "lint": "eslint \"**/*.{js,ts}\" && npm run test:build",
    "lint:fix": "eslint \"**/*.{js,ts}\" --fix",
    "test": "jest src",
    "test:watch": "jest --watch src",
    "test:cov": "jest --coverage src",
    "test:e2e": "jest tests",
    "test:build": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "command": "node bin/index.js",
    "plugin-installer": "liquio-plugin-installer"
  },
  "dependencies": {
    "@liquio/back-core": "^0.1.2",
    "@liquio/plugin-installer": "^0.1.3",
    "@liquio/plugin-sdk": "^0.1.5",
    "ajv": "^6.12.6",
    "amqplib": "^0.10.9",
    "asn1.js": "^5.4.1",
    "axios": "^1.13.6",
    "bn.js": "^5.2.3",
    "body-parser": "^1.19.0",
    "buffer": "^5.6.0",
    "ccolor": "^1.3.1",
    "cors": "^2.8.6",
    "cyrillic-to-translit-js": "^3.1.0",
    "express": "^5.2.1",
    "express-form-data": "^2.0.10",
    "express-validator": "^6.6.0",
    "express-xml-bodyparser": "^0.4.1",
    "fetch-to-curl": "^0.6.0",
    "flattening": "^2.4.2",
    "gost89": "^0.1.11",
    "got": "^11.8.2",
    "handlebars": "^4.7.8",
    "iconv-lite": "^0.7.2",
    "jcopy": "^1.0.3",
    "jksreader": "^1.0.0",
    "js-lzma": "^0.1.0",
    "jsonc-parser": "^3.2.0",
    "jsonpath-plus": "^10.4.0",
    "jsonwebtoken": "^9.0.3",
    "ldapts": "^8.1.7",
    "lodash": "^4.17.15",
    "moment": "^2.24.0",
    "moment-business-days": "^1.1.3",
    "multer": "^2.1.1",
    "multiconf": "^4.2.1",
    "node-fetch": "^3.3.1",
    "node-html-parser": "^7.1.0",
    "node-schedule": "^2.1.1",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.3",
    "php-unserialize": "0.0.1",
    "prop-by-path": "^1.1.2",
    "qr-image": "^3.2.0",
    "qs": "^6.15.0",
    "queue-promise": "^2.2.1",
    "raw-body": "^2.4.0",
    "redis": "^5.11.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "transliteration": "^2.6.1",
    "validator": "^13.15.26",
    "ws": "^8.19.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz",
    "xml2js": "^0.6.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^11.13.0",
    "@testcontainers/redis": "^11.13.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "escape-regex-string": "^1.0.6",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "nock": "^14.0.17",
    "portfinder": "^1.0.37",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "semver": "7.5.4",
    "tough-cookie": "4.1.3",
    "form-data": "2.5.5",
    "express-xml-bodyparser": {
      "xml2js": "0.6.2"
    }
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "isolated-vm@6.2.0": true,
    "protobufjs@7.6.5": true,
    "ssh2@1.17.0": true,
    "unrs-resolver@1.12.2": true
  }
}
