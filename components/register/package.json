{
  "name": "liquio-register",
  "version": "1.0.0",
  "engines": {
    "node": "24"
  },
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "main": "src/index.ts",
  "scripts": {
    "start": "node src/index.js",
    "start:prod": "node src/index.js",
    "start:ts": "node --expose-gc -r ts-node/register src/index.ts",
    "start:dev": "DISABLE_LOG=true node --expose-gc -r ts-node/register src/index.ts",
    "build": "tsc",
    "lint": "eslint \"{src,apps,libs,tests}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,tests}/**/*.ts\" --fix",
    "test": "jest src",
    "test:e2e": "jest --verbose --coverage tests",
    "migration-generate": "sequelize-cli migration:generate --config migrations-config.js --name new-migration",
    "migration-up": "sequelize db:migrate --config migrations-config.js",
    "migration-clear": "sequelize db:migrate:undo:all --config migrations-config.js"
  },
  "dependencies": {
    "@liquio/back-core": "^1.0.0",
    "ajv": "^8.20.0",
    "axios": "^1.18.1",
    "deepmerge": "^4.3.1",
    "dompurify": "^3.3.1",
    "express": "^5.2.1",
    "express-validator": "^6.14.3",
    "flattenjs": "^2.1.3",
    "jsdom": "^27.3.0",
    "json2csv": "^5.0.7",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "multiconf": "^4.2.1",
    "object-path": "^0.11.8",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/express": "5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "25.3.3",
    "@types/object-path": "0.11.4",
    "@types/pg": "8.18.0",
    "@types/supertest": "7.2.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    },
    "sequelize": {
      "uuid": "^11.1.1"
    }
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "protobufjs@7.5.4": true,
    "ssh2@1.17.0": true,
    "unrs-resolver@1.12.2": true,
    "isolated-vm@6.2.0": true
  }
}
