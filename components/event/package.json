{
  "name": "liquio-event",
  "version": "0.1.10",
  "engines": {
    "node": "22"
  },
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:ts": "node -r ts-node/register src/index.ts",
    "build": "tsc",
    "migration-up": "sequelize db:migrate",
    "migration-clear": "sequelize db:migrate:undo:all",
    "lint": "eslint \"**/*.{js,ts}\" && npm run test:build",
    "lint:fix": "eslint \"**/*.{js,ts}\" --fix",
    "test": "jest src",
    "test:watch": "jest --watch src",
    "test:cov": "jest --coverage src",
    "test:e2e": "jest --coverage --verbose tests",
    "test:build": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "plugin-installer": "liquio-plugin-installer"
  },
  "keywords": [
    "bpmn",
    "event"
  ],
  "dependencies": {
    "@liquio/back-core": "^0.1.0",
    "@liquio/plugin-installer": "^0.1.3",
    "@liquio/plugin-sdk": "^0.1.2",
    "acorn": "^8.16.0",
    "adm-zip": "^0.5.10",
    "amqplib": "^0.10.9",
    "archiver": "^5.3.1",
    "axios": "^1.18.1",
    "ccolor": "^1.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "fetch-to-curl": "^0.5.2",
    "got": "^15.1.0",
    "iconv-lite": "^0.6.3",
    "isolated-vm": "^6.1.2",
    "jsonc-parser": "^3.2.0",
    "jsonpath-plus": "^10.4.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "lru-cache": "^11.2.7",
    "moment": "^2.29.4",
    "moment-business-days": "^1.2.0",
    "multiconf": "^4.0.0",
    "multistream": "^4.1.0",
    "node-fetch": "^3.3.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "prop-by-path": "^1.1.2",
    "qs": "^6.15.0",
    "queue-promise": "^2.2.1",
    "redis": "^5.11.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "ssh2-sftp-client": "^9.0.4",
    "ws": "^8.19.0",
    "xml2js": "^0.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^11.13.0",
    "@testcontainers/redis": "^11.13.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^4.17.16",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "@types/xml2js": "^0.4.14",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "nock": "^14.0.11",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "semver": "7.5.4",
    "tough-cookie": "4.1.3",
    "form-data": "2.5.5"
  }
}
