{
  "name": "liquio-filestorage",
  "version": "1.0.0",
  "engines": {
    "node": "24"
  },
  "private": true,
  "main": "src/app.js",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "scripts": {
    "start": "node src/app.js",
    "start:prod": "node src/app.js",
    "start:ts": "node -r ts-node/register src/app.ts",
    "build": "tsc",
    "lint": "eslint \"**/*.{js,ts}\"",
    "lint:fix": "eslint \"**/*.{js,ts}\" --fix",
    "migration-up": "sequelize db:migrate",
    "migration-clear": "sequelize db:migrate:undo:all",
    "seed-up": "sequelize db:seed:all",
    "seed-clear": "sequelize db:seed:undo:all",
    "test": "jest src",
    "test:watch": "jest src --watch",
    "test:cov": "jest src --coverage",
    "test:e2e": "jest tests"
  },
  "dependencies": {
    "@liquio/back-core": "^1.0.0",
    "adm-zip": "^0.6.1",
    "axios": "^1.19.0",
    "body-parser": "^2.3.0",
    "express": "^5.2.1",
    "inquirer": "^14.2.3",
    "jsontoxml": "^1.0.1",
    "jszip": "^3.10.2",
    "lodash": "^4.17.21",
    "mime-types": "^3.0.2",
    "moment": "^2.31.0",
    "multiconf": "^4.2.2",
    "pg": "^8.23.1",
    "sequelize": "^6.30.0",
    "sequelize-cli": "^6.6.5",
    "swagger-ui-express": "^5.0.1",
    "transliteration": "^2.6.1",
    "ua-en-translit": "^3.1.2",
    "xml2js": "^0.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "debug": "^4.3.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.2",
    "nock": "^14.0.17",
    "portfinder": "^1.0.37",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    },
    "sequelize": {
      "uuid": "^11.1.1"
    }
  }
}
